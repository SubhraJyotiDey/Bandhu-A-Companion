[Unit]
Description=Bandhu Elder Care Companion Daemon (Servos + Voice AI + Medicine Scheduler + Web UI)
Documentation=https://github.com/SubhraJyotiDey/Bandhu-A-Companion
After=network-online.target sound.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/joyful-meitner

# Run via startup wrapper to load PATH, audio sockets, and python environment
ExecStart=/bin/bash /home/pi/joyful-meitner/scripts/start_companion.sh

Environment=PULSE_SERVER=unix:/run/user/1000/pulse/native
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/home/pi

# Restart policy: automatically recover on crash
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# Logging: accessible via journalctl -u bandhu-companion.service -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bandhu-companion

[Install]
WantedBy=multi-user.target
